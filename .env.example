# Slack Bot Configuration
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_APP_TOKEN=xapp-your-app-token   # For Socket Mode (recommended)

# Anthropic / Claude API
ANTHROPIC_API_KEY=sk-ant-your-key
CLAUDE_MODEL=claude-opus-4-5          # Optional: override Claude model

# GitHub Configuration
GITHUB_TOKEN=ghp_your-personal-access-token
GITHUB_OWNER=lc-dblabs
GITHUB_REPO=gtm

# Skill Sources — comma-separated list of GitHub repos to load SKILL.md workflows from
# The GITHUB_OWNER/GITHUB_REPO above is always included automatically
SKILL_SOURCES=anthropics/knowledge-work-plugins,Clearcover/ai-plugin-marketplace

# Server Configuration (only needed without Socket Mode)
PORT=3000
