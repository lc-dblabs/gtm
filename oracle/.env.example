# Slack Bot Configuration
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_APP_TOKEN=xapp-your-app-token   # For Socket Mode (recommended)

# Anthropic / Claude API
ANTHROPIC_API_KEY=sk-ant-your-key
CLAUDE_MODEL=claude-opus-4-5          # Optional: override Claude model

# GitHub Configuration
GITHUB_TOKEN=ghp_your-personal-access-token
GITHUB_OWNER=DearbornLabs
GITHUB_REPO=dl-shared-kb

# Skill discovery — scans for SKILL.md files at runtime
# Scan all repos in an org (recommended):
SKILL_ORGS=DearbornLabs
# Or specify individual repos:
# SKILL_SOURCES=DearbornLabs/dl-shared-kb,DearbornLabs/other-repo

# Server Configuration (only needed without Socket Mode)
PORT=3000
